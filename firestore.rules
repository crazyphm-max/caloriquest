// Regras de segurança do Firestore do CaloriQuest.
//
// Cole em console.firebase.google.com → Firestore Database → aba Regras →
// Publicar. Sem isto o banco fica aberto ou fechado demais — é aqui, e não nas
// chaves do firebase-config.js, que os dados ficam protegidos.
//
// Em português claro: cada pessoa logada só enxerga e só escreve o documento
// que tem o próprio id dela. O resto do banco é inacessível para todo mundo.
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // qualquer outro caminho fica bloqueado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
